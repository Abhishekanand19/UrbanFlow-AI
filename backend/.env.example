# Backend environment variables (set these in the Railway dashboard)

# Google Gemini API key used by ai_brief.py
GEMINI_API_KEY=your-gemini-api-key

# Comma-separated list of allowed CORS origins (the deployed frontend URL).
# Vercel preview URLs (*.vercel.app) are always allowed automatically.
ALLOWED_ORIGINS=https://flipkart-urbanflow.vercel.app

# PORT is provided automatically by Railway; only set locally if needed.
# PORT=8000
